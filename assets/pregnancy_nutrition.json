    "generalSafety": {
      "name": "General Food Safety: AVOID at All Times",
      "items": [
        {
          "item": "Alcohol (Raksi/Jand)",
          "reason": "No safe amount has been established; high risk of Fetal Alcohol Syndrome."
        },
        {
          "item": "Tobacco/Smoking",
          "reason": "Avoid both active and passive smoking."
        },
        {
          "item": "Raw/Unwashed Fruits and Vegetables",
          "reason": "Risk of Toxoplasmosis and other pathogens. Wash all produce thoroughly with clean water."
        },
        {
          "item": "Street-side Juices/Salads",
          "reason": "High risk of bacterial contamination due to unclean water or poor preparation hygiene."
        },
        {
          "item": "Unsafe Water",
          "reason": "Only drink boiled, filtered, or commercially bottled water."
        },
        {
          "item": "Reheated Rice or Foods Left at Room Temperature",
          "reason": "Risk of food poisoning from bacterial growth (like *Bacillus cereus* in rice). Always store food properly and reheat until steaming hot."
        },
        {
          "item": "Herbal Supplements/Traditional Medicines",
          "reason": "Consult a doctor before taking any non-prescribed herbs (e.g., Jhar-phuk) or supplements as some can be harmful to the pregnancy."
        },
        {
          "item": "Excessive Simple Sugar (Mithai)",
          "reason": "Limit intake of processed sweets and sugary drinks to prevent excessive weight gain and manage blood sugar."
        },
        {
          "item": "Very Oily/Fried Foods",
          "reason": "Can worsen acid reflux and heartburn, which is common in the third trimester."
        },
        {
          "item": "Spicy Foods",
          "reason": "May cause heartburn"
        },
       
        {
          "item": "Large Meals",
          "reason": "Eat small, frequent meals instead to ease pressure on the stomach and aid digestion."
        }
      
